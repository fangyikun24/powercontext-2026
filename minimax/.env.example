# Copy to `.env` and fill in real values. Never commit `.env`.
# All placeholder values below are examples only.

# ---------------------------------------------------------------------------
# Model provider — MiniMax is the provider required by the task.
# ---------------------------------------------------------------------------
# MiniMax 有两类密钥，用途不同：
#   sk-api-...  API 计费密钥，走「积分/钱包」余额
#   sk-cp-...   Coding Plan 密钥，走 M Plan 订阅额度（本模块实测可用的是这一类）
# 若 sk-api- 密钥返回 402 insufficient_balance_error，请改用 sk-cp- 密钥。
SDDCTX_LLM_PROVIDER=minimax
MINIMAX_API_KEY=<your-minimax-api-key>
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_MODEL=MiniMax-M3.1-Flash
# M3 系列强制 adaptive thinking，不能关闭；effort 越低越少消耗 max_tokens。
# 可选 low / medium / high，留空则不发送该参数。
MINIMAX_REASONING_EFFORT=low

# Optional alternative provider (OpenAI-compatible). Not used for the submission
# record unless SDDCTX_LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# seekdb (embedded, zero setup) or oceanbase (external MySQL-mode tenant).
SDDCTX_MATERIALS_BACKEND=seekdb
# SDDCTX_MATERIALS_SEEKDB_PATH=./state/materials
# Required only when SDDCTX_MATERIALS_BACKEND=oceanbase:
# SDDCTX_OCEANBASE_URL=mysql+aoceanbase://root:<password>@127.0.0.1:2881/powercontext?charset=utf8mb4

# PowerContext state backend: seekdb (default) or sqlite.
SDDCTX_STATE_BACKEND=seekdb

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# SDDCTX_HOME=./state
# SDDCTX_PROJECT=./sample-project
# SDDCTX_ARTIFACTS=./artifacts
